# ============================================================
# HawkEye v2.2.3 — Environment Variables Template
# Copy this file to .env and fill in your API keys
# cp .env.example .env
# ============================================================

# ─── AI Provider — أضف مفتاح واحد فقط، البرنامج يكتشف الـ Provider تلقائياً ───
# Priority: Claude → DeepSeek → OpenAI → OpenRouter

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# DeepSeek (cheapest — recommended)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# OpenRouter (access multiple models)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ─── Optional Integrations ───────────────────────────────────
# C99.nl — extra subdomain intelligence
C99_API_KEY=your-c99-api-key-here

# ─── Optional Authorized Target Session ─────────────────────
# Uncomment only when authentication is configured in config.yaml.
# Use a dedicated, low-privilege test account.
# TARGET_TOKEN=replace-with-a-limited-test-token
# TARGET_SESSION=replace-with-a-limited-test-session
