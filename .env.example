# ============================================================
# HawkEye v2.3.0 — Environment Variables Template
# Copy this file to .env and fill in your API keys
# cp .env.example .env
# chmod 600 .env
# ============================================================

# ─── AI Provider ─────────────────────────────────────────────
# Fill exactly one provider key when config.yaml uses provider: auto. If you
# keep multiple real keys, select the provider explicitly in config.yaml.

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# OpenRouter (access multiple models)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Custom OpenAI-compatible endpoint. Configure provider, model, and base_url
# together under ai: in config.yaml; custom cannot be selected by a flag alone.
AI_API_KEY=your-custom-provider-api-key-here

# ─── Optional Integrations ───────────────────────────────────
# C99.nl — extra subdomain intelligence
C99_API_KEY=your-c99-api-key-here

# ─── Optional Authorized Target Session ─────────────────────
# Uncomment only when authentication is configured in config.yaml.
# Use a dedicated, low-privilege test account.
# TARGET_TOKEN=replace-with-a-limited-test-token
# TARGET_SESSION=replace-with-a-limited-test-session
