        }
      },
      "provider_decision": {
        "decision": "confirmed",
        "confidence": 0.94,
        "evidence_refs": ["evidence", "curl"],
        "missing_evidence": [],
        "analysis": "The scanner captured successful TLS 1.0 negotiation and a reproducible command.",
        "impact_assessment": "The endpoint accepts an obsolete TLS protocol.",
        "remediation": "Disable TLS 1.0 and require TLS 1.2 or newer.",
        "proof_of_concept": "Use the captured openssl command against the reserved test host.",
        "cybersecurity_context": "CWE-326",
        "bug_bounty_value": "medium"
      }
    }
